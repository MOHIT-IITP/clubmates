generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {
    id   Int   @id @default(autoincrement())
    name String
    email String @unique
    clubName String 
    templates Template[]
    reports Report[]
}

model Template {
    id   Int   @id @default(autoincrement())
    title  String
    author  User?  @relation(fields: [authorId], references: [id])
    authorId Int?
}

model Report {
    id   Int   @id @default(autoincrement())
    author  User?  @relation(fields: [authorId], references: [id])
    authorId Int?
}
